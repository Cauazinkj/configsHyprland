{
  "layer": "top",
  "position": "top",
  "margin-bottom": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["tray", "pulseaudio", "network", "battery", "clock"],

  "tray": {
    "spacing": 10
  },

  "clock": {
    "format": "  {:%a %d/%m}   {:%I:%M %p}",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "{:%A %d %B %Y \\n %H:%M:%S}"
  },

  "hyprland/workspaces": {
    "format": "{icon} {name}",
    "disable-scroll": true,
    "all-outputs": false
  },

  "hyprland/window": {
    "format": "{}"
  },

  "pulseaudio": {
    "on-click": "pavucontrol"
  },

  "network": {
    "interval": 2
  },

  "memory": {
    "tooltip": false
  },

  "cpu": {
    "tooltip": false
  }
}